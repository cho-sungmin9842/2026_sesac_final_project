map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
# 컨테이너가 시작될 때 ${API_UPSTREAM}, ${NGINX_LOCAL_RESOLVERS} 가 실제 값으로 채워집니다.
# (정의된 환경변수만 치환하므로 $uri, $host 같은 nginx 변수는 그대로 남습니다.)
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API 는 백엔드로 전달합니다. 쿠버네티스에서 Ingress 가 /api 를 백엔드로 직접 보내면 이 블록은 쓰이지 않습니다.
    # proxy_pass 에 변수를 쓰면 요청마다 이름을 찾으므로, 백엔드 컨테이너가 아직 안 떠 있어도 nginx 는 정상 시작합니다
    # (고정 주소로 쓰면 "host not found in upstream" 으로 시작 자체가 실패합니다).
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # AI 챗봇/줄거리 요약(Gemini)은 응답이 느릴 수 있어 넉넉히 둡니다.
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
    }

    # 빌드 결과물의 파일 이름에는 해시가 들어 있어서 오래 캐시해도 안전합니다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # React 라우팅: /movies/123 같은 주소를 새로고침해도 index.html 을 돌려줍니다.
    # index.html 자체는 캐시하지 않아야 새 배포가 바로 반영됩니다.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
